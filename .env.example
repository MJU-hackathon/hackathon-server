# DB (docker compose와 Spring이 같이 사용, 로컬 전용 값)
DB_URL=jdbc:mysql://localhost:3306/thingkerton?serverTimezone=Asia/Seoul
DB_USERNAME=thingkerton
DB_PASSWORD=thingkerton
# DB_ROOT_PASSWORD=root
# DB_PORT=3306

SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# S3 (선택, 생략 시 기본값 사용)
# AWS 키는 여기에 넣지 않습니다. 로컬은 `aws configure`, EC2는 IAM Role을 사용합니다.
S3_BUCKET=mju-hackathon-photos-2026
S3_REGION=ap-southeast-2

# Naver Maps
NAVER_MAPS_API_KEY_ID=
NAVER_MAPS_API_KEY=

# Gemini (https://aistudio.google.com 에서 발급, 실제 키는 커밋 금지)
GEMINI_API_KEY=YOUR_API_KEY
# GEMINI_CHAT_MODEL=gemini-3.6-flash
# GEMINI_THINKING_LEVEL=low
# 퀘스트 대표 이미지 생성기 (cloudflare | gemini, 기본 cloudflare)
# QUEST_IMAGE_PROVIDER=cloudflare
# Gemini 이미지 모델은 무료 등급이 없어 결제 연결 필요 (QUEST_IMAGE_PROVIDER=gemini일 때만 사용)
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# GEMINI_IMAGE_ASPECT_RATIO=4:3
# QUEST_GENERATION_TIMEOUT=15s
# QUEST_TRANSLATION_TIMEOUT=10s
# QUEST_GEOCODING_TIMEOUT=3s
# QUEST_IMAGE_GENERATION_TIMEOUT=12s

# 퀘스트 기본 대표 이미지 (데모 퀘스트·AI 생성 실패 시, 선택, TODO: 팀 이미지 경로로 교체)
# QUEST_IMAGE_BASE_URL=https://cdn.example.com/quest-images

# Cloudflare Workers AI (퀘스트 대표 이미지, 대시보드 AI > Workers AI > Use REST API에서 발급, 실제 값 커밋 금지)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# CLOUDFLARE_IMAGE_STEPS=4
